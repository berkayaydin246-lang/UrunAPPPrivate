<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) mandatory SplashScreen customisation.
         Without this, the system wraps ic_launcher in a WHITE rounded
         container regardless of our LaunchTheme windowBackground. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Fill the system-mandated splash background with logo cream -->
        <item name="android:windowSplashScreenBackground">@color/splashBackground</item>
        <!-- High-res transparent splash logo (960×960 @ xxxhdpi, generated
             from the 2048×2048 source). Replaces the tiny @mipmap/ic_launcher
             (192 px) that caused severe upscaling blur on API 31+. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/etiketly_splash_logo</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splashBackground</item>
    </style>
</resources>
